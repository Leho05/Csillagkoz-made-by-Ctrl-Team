<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.csillagkoz.controller.TicketBookingController">

    <!-- Rádiógombok összekapcsolásához szükséges csoport definíciója -->
    <fx:define>
        <ToggleGroup fx:id="classToggleGroup"/>
    </fx:define>

    <VBox alignment="CENTER" spacing="12.0">
        <children>
            <Label text="CSILLAGKÖZI LÉGITÁRSASÁG" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label text="Intergalaktikus Jegyfoglalás" style="-fx-text-fill: #666666;"/>

            <!-- Indulási csillagbázis / Bolygó neve és legördülő listája -->
            <HBox maxWidth="300.0" alignment="BOTTOM_LEFT" spacing="8.0">
                <children>
                    <Label text="Indulási csillagbázis / Bolygó:"/>
                    <Label fx:id="departureErrorLabel" text="* A mező kitöltése kötelező" style="-fx-text-fill: #ff4d4d; -fx-font-size: 11px;" visible="false" managed="false"/>
                </children>
            </HBox>
            <ComboBox fx:id="departureComboBox" promptText="Válasszon indulási helyet..." prefWidth="300.0"/>

            <!-- Célállomás (Bolygó, hold) neve és legördülő listája -->
            <HBox maxWidth="300.0" alignment="BOTTOM_LEFT" spacing="8.0">
                <children>
                    <Label text="Célállomás (Bolygó / Kolónia):"/>
                    <Label fx:id="destinationErrorLabel" text="* A mező kitöltése kötelező" style="-fx-text-fill: #ff4d4d; -fx-font-size: 11px;" visible="false" managed="false"/>
                </children>
            </HBox>
            <ComboBox fx:id="destinationComboBox" promptText="Válasszon célállomást..." prefWidth="300.0"/>

            <!-- Utazás dátuma (DatePicker) naptáras megjelenítéssel -->
            <HBox maxWidth="300.0" alignment="BOTTOM_LEFT" spacing="8.0">
                <children>
                    <Label text="Utazás dátuma:"/>
                    <Label fx:id="dateErrorLabel" text="* A mező kitöltése kötelező" style="-fx-text-fill: #ff4d4d; -fx-font-size: 11px;" visible="false" managed="false"/>
                </children>
            </HBox>
            <DatePicker fx:id="flightDatePicker" promptText="ÉÉÉÉ. HH. NN." prefWidth="300.0"/>

            <!-- Utas típusa / Kedvezmény legördülő listája -->
            <HBox maxWidth="300.0" alignment="BOTTOM_LEFT" spacing="8.0">
                <children>
                    <Label text="Utas típusa / Kedvezmény:"/>
                    <Label fx:id="passengerErrorLabel" text="* A mező kitöltése kötelező" style="-fx-text-fill: #ff4d4d; -fx-font-size: 11px;" visible="false" managed="false"/>
                </children>
            </HBox>
            <ComboBox fx:id="passengerTypeComboBox" promptText="Válasszon kedvezménytípust..." prefWidth="300.0"/>

            <!-- Kabin osztály rádiógombok -->
            <HBox maxWidth="300.0" alignment="BOTTOM_LEFT" spacing="8.0">
                <children>
                    <Label text="Kabin osztály:"/>
                    <Label fx:id="classErrorLabel" text="* A mező kitöltése kötelező" style="-fx-text-fill: #ff4d4d; -fx-font-size: 11px;" visible="false" managed="false"/>
                </children>
            </HBox>
            <VBox fx:id="radioContainer" spacing="5.0" prefWidth="300.0" maxWidth="300.0">
                <children>
                    <RadioButton fx:id="economyRadioButton" text="Economy (Harmad osztály)" toggleGroup="$classToggleGroup"/>
                    <RadioButton fx:id="businessRadioButton" text="Business (Másod osztály)" toggleGroup="$classToggleGroup"/>
                    <RadioButton fx:id="firstClassRadioButton" text="First Class (Első osztály)" toggleGroup="$classToggleGroup"/>
                </children>
            </VBox>

            <!-- Alsó gombsor (Mégse és Járatok keresése) -->
            <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10 0 0 0;">
                <children>
                    <Button fx:id="backToLoginButton" text="⬅ Bejelentkezés / Fiókváltás" onAction="#handleBackToLogin" />
                    <Button fx:id="cancelButton" text="Törlés" prefWidth="130.0" onAction="#handleCancel"/>
                    <Button fx:id="adminButton" text="Admin felület" onAction="#handleOpenAdmin" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-weight: bold;" />
                    <Button fx:id="searchButton" text="Járatok keresése ➔" prefWidth="150.0" onAction="#handleSearchFlights"/>
                </children>
            </HBox>
            <Button fx:id="cartButton" text="Kosár (0 db jegy) -> Fizetés" onAction="#handleOpenCart" visible="false" managed="false" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" />
        </children>
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>
    </VBox>

    <Button fx:id="errorReportButton" onAction="#handleOpenErrorReport" pickOnBounds="true"
            style="-fx-background-color: transparent; -fx-padding: 4; -fx-cursor: hand;"
            StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets bottom="16.0" right="16.0" />
        </StackPane.margin>
        <graphic>
            <StackPane prefWidth="32.0" prefHeight="30.0">
                <SVGPath content="M 16 3 L 30 27 L 2 27 Z"
                         fill="#ffc107" stroke="#d39e00" strokeWidth="2.5" strokeLineJoin="round" />
                <HBox alignment="CENTER" translateY="4.0">
                    <Label text="!" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #212529;" />
                </HBox>
            </StackPane>
        </graphic>
    </Button>
</StackPane>