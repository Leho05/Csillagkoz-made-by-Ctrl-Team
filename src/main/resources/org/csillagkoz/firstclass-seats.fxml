<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.GridPane?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.csillagkoz.controller.FirstClassController">
    <VBox alignment="CENTER" spacing="20.0">
        <children>
            <Label text="FIRST CLASS - ELSŐ OSZTÁLY" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label text="Luxus kabinok, maximális kényelem és privát szféra." style="-fx-text-fill: #666666;"/>

            <GridPane fx:id="seatGrid" hgap="8.0" vgap="8.0" alignment="CENTER"/>
            <Label fx:id="selectedSeatLabel" text="Kiválasztott szék: nincs" style="-fx-font-weight: bold;"/>
            <Label fx:id="errorLabel" text="Kérjük, válasszon egy széket!" style="-fx-text-fill: #ff4d4d;" visible="false" managed="false"/>
            <HBox alignment="CENTER" spacing="20.0">
                <children>
                    <Button text="← Vissza az előző oldalra" onAction="#handleBack"/>
                    <Button text="Tovább a személyes adatokhoz →" onAction="#handleNext"/>
                </children>
            </HBox>
        </children>
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>
    </VBox>

    <Button fx:id="errorReportButton" onAction="#handleOpenErrorReport" pickOnBounds="true"
            style="-fx-background-color: transparent; -fx-padding: 4; -fx-cursor: hand;"
            StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets bottom="16.0" right="16.0" />
        </StackPane.margin>
        <graphic>
            <StackPane prefWidth="32.0" prefHeight="30.0">
                <SVGPath content="M 16 3 L 30 27 L 2 27 Z"
                         fill="#ffc107" stroke="#d39e00" strokeWidth="2.5" strokeLineJoin="round" />
                <HBox alignment="CENTER" translateY="4.0">
                    <Label text="!" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #212529;" />
                </HBox>
            </StackPane>
        </graphic>
    </Button>
</StackPane>