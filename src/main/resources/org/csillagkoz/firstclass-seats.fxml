<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.csillagkoz.controller.FirstClassController">
    <children>
        <Label text="FIRST CLASS - ELSŐ OSZTÁLY" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Label text="Luxus kabinok, maximális kényelem és privát szféra." style="-fx-text-fill: #666666;"/>

        <!-- Itt lesz majd az első osztályú luxus székek -->
        <Label text="[ Ide jönnek az első osztályú luxus székek ]" style="-fx-padding: 40px;"/>

        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button text="← Vissza az előző oldalra" onAction="#handleBack"/>
                <Button text="Tovább a személyes adatokhoz →" onAction="#handleNext"/>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
</VBox>